{
  "name": "kinstate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "packages/compiler",
    "packages/tests",
    "packages/examples/*",
    "website"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build -w @kinstate/core && npm run build -w @kinstate/react && npm run build -w @kinstate/compiler && tsc -p distribution/tsconfig.json && node scripts/build-git-distribution.mjs",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:phase1": "vitest run packages/tests/phase1",
    "test:watch": "vitest",
    "test:matrix": "node scripts/react-matrix.mjs",
    "test:packages": "node scripts/verify-packages.mjs",
    "test:browser": "playwright test",
    "bench": "npm run build && tsx benchmarks/run.tsx",
    "build:examples": "npm run build && npm run build -w @kinstate/example-vite && npm run build -w @kinstate/example-next",
    "check": "npm run typecheck && npm test && npm run check:boundaries && npm run format:check && node scripts/check-hooks.mjs && npm run bench:test && npm run bench:typecheck && npm run test:distribution && npm run test:packages && npm run test:git",
    "check:hooks": "npm run build && node scripts/check-hooks.mjs",
    "bench:quick": "npm run build && tsx benchmarks/run.tsx --quick",
    "bench:test": "node --import tsx --test benchmarks/*.test.mjs benchmarks/*.test.ts",
    "bench:typecheck": "tsc -p benchmarks/tsconfig.json",
    "bench:smoke": "npm run build && tsx benchmarks/smoke.mjs",
    "format": "prettier --write \"packages/{core,react,compiler,tests}/**/*.{ts,tsx,mjs,cts}\" \"benchmarks/**/*.{ts,tsx,mjs,css}\" \"scripts/*.mjs\" \"website/**/*.{ts,tsx,mjs,cjs,css}\" \"distribution/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/{core,react,compiler,tests}/**/*.{ts,tsx,mjs,cts}\" \"benchmarks/**/*.{ts,tsx,mjs,css}\" \"scripts/*.mjs\" \"website/**/*.{ts,tsx,mjs,cjs,css}\" \"distribution/src/**/*.ts\"",
    "check:boundaries": "node scripts/check-boundaries.mjs && node --test scripts/check-boundaries.test.mjs",
    "test:load": "node scripts/production-load.mjs",
    "test:load:long": "node scripts/production-load.mjs --long",
    "docs:dev": "npm run build && npm run dev -w @kinstate/docs",
    "docs:build": "npm run build && npm run build -w @kinstate/docs",
    "docs:preview": "npm run preview -w @kinstate/docs --",
    "docs:check": "npm run typecheck -w @kinstate/docs && node website/scripts/check-site.mjs",
    "docs:test": "playwright test --config website/playwright.config.ts",
    "test:next:dev": "playwright test --config next-dev-tests/playwright.config.ts",
    "prepare": "npm run build",
    "test:git": "node scripts/verify-git-install.mjs",
    "test:distribution": "node --test scripts/build-git-distribution.test.mjs",
    "test:yarn": "node scripts/verify-yarn-distribution.mjs"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.27.0",
    "@babel/preset-typescript": "^7.27.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.1.0",
    "next": "^16.4.2",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "valtio": "^2.1.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.0",
    "magic-string": "^0.30.21",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "description": "Kinstate Git distribution. Ordinary classes. Reactive state.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "distribution/dist",
    "distribution/src",
    "README.md",
    "LICENSE",
    "distribution/sources"
  ],
  "exports": {
    ".": {
      "types": "./distribution/dist/core.d.ts",
      "import": "./distribution/dist/core.js",
      "default": "./distribution/dist/core.js"
    },
    "./core": {
      "types": "./distribution/dist/core.d.ts",
      "import": "./distribution/dist/core.js",
      "default": "./distribution/dist/core.js"
    },
    "./react": {
      "types": "./distribution/dist/react.d.ts",
      "import": "./distribution/dist/react.js",
      "default": "./distribution/dist/react.js"
    },
    "./react/internal": {
      "types": "./distribution/dist/internal.d.ts",
      "import": "./distribution/dist/internal.js",
      "default": "./distribution/dist/internal.js"
    },
    "./internal": {
      "types": "./distribution/dist/internal.d.ts",
      "import": "./distribution/dist/internal.js",
      "default": "./distribution/dist/internal.js"
    },
    "./compiler": {
      "types": "./distribution/dist/compiler.d.ts",
      "import": "./distribution/dist/compiler.js",
      "default": "./distribution/dist/compiler.js"
    },
    "./compiler/vite": {
      "types": "./distribution/dist/vite.d.ts",
      "import": "./distribution/dist/vite.js",
      "default": "./distribution/dist/vite.js"
    },
    "./compiler/next": {
      "types": "./distribution/dist/next.d.ts",
      "import": "./distribution/dist/next.js",
      "default": "./distribution/dist/next.js"
    }
  },
  "main": "./distribution/dist/core.js",
  "types": "./distribution/dist/core.d.ts",
  "dependencies": {
    "@babel/core": "^7.28.0",
    "@babel/types": "^7.28.0",
    "@types/babel__core": "^7.20.5"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "vite": ">=5 <9",
    "next": ">=16 <17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}

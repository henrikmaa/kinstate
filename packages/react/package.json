{
  "name": "@kinstate/react",
  "version": "0.1.0",
  "type": "module",
  "description": "Kinstate compiler-assisted fine-grained React service subscriptions",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run --root ../.. --config vitest.config.ts packages/tests"
  },
  "dependencies": {
    "@kinstate/core": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "allowImportingTsExtensions": true,
    "declarationMap": false
  },
  "include": [
    "browser-tests/**/*.ts",
    "next-dev-tests/**/*.ts",
    "playwright.config.ts",
    "packages/tests/**/*.ts",
    "packages/tests/**/*.tsx",
    "packages/core/test/**/*.ts",
    "packages/compiler/test/**/*.ts"
  ]
}
